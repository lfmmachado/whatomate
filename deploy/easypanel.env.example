# Variáveis da aba de ambiente do EasyPanel, consumidas por easypanel-compose.yml.
# Copiar, preencher e colar no painel. NÃO commitar a versão preenchida.

WHATOMATE_DOMAIN=chat.mooviin.app

# IP público da EC2. Hoje é o auto-atribuído, que muda em stop/start —
# ao alocar um Elastic IP, trocar aqui e redeployar.
PUBLIC_IP=3.93.191.20

# Endpoint do RDS (o app conecta direto, sem passar pelo pgbouncer)
RDS_HOST=wgl-postgres-rds.cwzwwdv44095.us-east-1.rds.amazonaws.com
RDS_PASSWORD=

# openssl rand -base64 32 — perder esta chave = perder os tokens Meta salvos
WHATOMATE_ENCRYPTION_KEY=
# openssl rand -base64 32
WHATOMATE_JWT_SECRET=

# openssl rand -hex 24 — o mesmo valor vai no painel da Meta
META_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

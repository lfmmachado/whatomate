# /etc/caddy/Caddyfile
# Trocar SEUDOMINIO pelo domínio real antes de aplicar na VPS.

crm.SEUDOMINIO.com.br {
	encode zstd gzip

	# WebSocket do chat e das chamadas passam pelo mesmo reverse_proxy
	reverse_proxy 127.0.0.1:8080 {
		# necessário para o rate_limit com trust_proxy = true no config.toml
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/whatomate.log
		format json
	}
}
